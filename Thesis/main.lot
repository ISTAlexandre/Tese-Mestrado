\contentsline {table}{\numberline {3.1}{\ignorespaces The three CMS data-tier formats, in decreasing order of size and detail. Sizes are approximate and quoted relative to the baseline AOD.}}{22}{table.caption.12}%
\contentsline {table}{\numberline {3.2}{\ignorespaces Characteristics of the JetHT primary dataset \blx@tocontentsinit {0}\cite {JetHT2016G}.}}{23}{table.caption.13}%
\contentsline {table}{\numberline {3.3}{\ignorespaces Quantities extracted from each event. The jet and constituent quantities are stored for both the collision data and the simulation. The generated partons are available in the simulation only.}}{24}{table.caption.14}%
\contentsline {table}{\numberline {3.4}{\ignorespaces Event and jet selection. The trigger and certified-run requirements apply to the collision data only.}}{24}{table.caption.15}%
\contentsline {table}{\numberline {3.5}{\ignorespaces Assignment of the splitting channel from the IFN flavours of the two branches of a generator-level splitting.}}{29}{table.caption.17}%
\contentsline {table}{\numberline {3.6}{\ignorespaces Composition of the labelled simulated sample by class of the second splitting, for jets with a valid $\Delta \psi _{12}$.}}{32}{table.caption.18}%
\contentsline {table}{\numberline {3.7}{\ignorespaces Input features of the two stages of the flavour selection. The superscripts $(3)$ and $(4)$ refer to the harder and softer branches of the second splitting.}}{33}{table.caption.19}%
\contentsline {table}{\numberline {3.8}{\ignorespaces Architecture and training configuration of the two stages of the flavour selection.}}{34}{table.caption.20}%
\contentsline {table}{\numberline {3.9}{\ignorespaces Overview of the sources of uncertainty and of their treatment in this work. Each source is discussed in the section indicated.}}{37}{table.caption.21}%
