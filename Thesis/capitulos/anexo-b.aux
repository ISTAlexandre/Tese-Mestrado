\providecommand\hyper@newdestlabel[2]{}
\@writefile{toc}{\contentsline {chapter}{\numberline {A}Supplementary Numerical Results}{70}{appendix.A}\protected@file@percent }
\@writefile{lof}{\addvspace {10\p@ }}
\@writefile{lot}{\addvspace {10\p@ }}
\newlabel{anexo:b}{{A}{70}{Supplementary Numerical Results}{appendix.A}{}}
\@writefile{lot}{\contentsline {table}{\numberline {A.1}{\ignorespaces Number of jets with a valid $\Delta \psi _{12}$, mean values of the momentum fractions $z_1$ and $z_2$ of the two selected splittings, and correlation coefficient between them, for all jets in the collision data and in the simulated calibration sample, and for the simulated jets in each class of the channel label of the second splitting. The fraction is given relative to all simulated jets. The statistical uncertainties are below $0.001$ for the mean values and below $0.005$ for the correlation coefficients.}}{70}{table.caption.44}\protected@file@percent }
\newlabel{tab:zplane}{{A.1}{70}{Number of jets with a valid $\dpsi $, mean values of the momentum fractions $z_1$ and $z_2$ of the two selected splittings, and correlation coefficient between them, for all jets in the collision data and in the simulated calibration sample, and for the simulated jets in each class of the channel label of the second splitting. The fraction is given relative to all simulated jets. The statistical uncertainties are below $0.001$ for the mean values and below $0.005$ for the correlation coefficients}{table.caption.44}{}}
\@writefile{lot}{\contentsline {table}{\numberline {A.2}{\ignorespaces Performance of the first stage of the flavour selection as a function of the threshold on the matched score, evaluated on the test set of the training sample. Among the labelled splittings of this set, a fraction $0.234$ is matched. The purity is the fraction of matched splittings among those selected, the efficiency is the fraction of matched splittings that are selected, and the last column gives the fraction of unmatched splittings that are selected. The threshold of $0.8$ is the one adopted in this work.}}{70}{table.caption.45}\protected@file@percent }
\newlabel{tab:stage1-scan}{{A.2}{70}{Performance of the first stage of the flavour selection as a function of the threshold on the matched score, evaluated on the test set of the training sample. Among the labelled splittings of this set, a fraction $0.234$ is matched. The purity is the fraction of matched splittings among those selected, the efficiency is the fraction of matched splittings that are selected, and the last column gives the fraction of unmatched splittings that are selected. The threshold of $0.8$ is the one adopted in this work}{table.caption.45}{}}
\@writefile{lot}{\contentsline {table}{\numberline {A.3}{\ignorespaces Mean value $\langle \cos 2\Delta \psi _{12}\rangle $ of the jets selected by the two-stage selection as a function of the threshold on the $g \to q\bar  {q}$ score, in the simulated calibration sample and in the collision data. All jets have a matched score above $0.8$. The purity is given as the interval between the values obtained by counting the jets without a channel label as background and excluding them. In simulation, the mean value is given for all selected jets, for those labelled $g \to q\bar  {q}$, and for those labelled $q \to qg$ or $g \to gg$. After the requirement on the matched score alone, these two labelled classes have mean values of $-0.2315 \pm 0.0027$ and $-0.1346 \pm 0.0011$. The uncertainties are statistical.}}{71}{table.caption.46}\protected@file@percent }
\newlabel{tab:modulation-scan}{{A.3}{71}{Mean value $\langle \cos 2\dpsi \rangle $ of the jets selected by the two-stage selection as a function of the threshold on the $g \to q\bar {q}$ score, in the simulated calibration sample and in the collision data. All jets have a matched score above $0.8$. The purity is given as the interval between the values obtained by counting the jets without a channel label as background and excluding them. In simulation, the mean value is given for all selected jets, for those labelled $g \to q\bar {q}$, and for those labelled $q \to qg$ or $g \to gg$. After the requirement on the matched score alone, these two labelled classes have mean values of $-0.2315 \pm 0.0027$ and $-0.1346 \pm 0.0011$. The uncertainties are statistical}{table.caption.46}{}}
\@writefile{lot}{\contentsline {table}{\numberline {A.4}{\ignorespaces Mean value $\langle \cos 2\Delta \psi _{12}\rangle $ as a function of the momentum fraction $z_2$ of the second splitting, for the simulated jets labelled $g \to q\bar  {q}$ and for those labelled $q \to qg$ or $g \to gg$, after the requirement of a matched score above $0.8$. The last column gives the difference between the two classes. The values correspond to the right panel of Figure~\ref {fig:z-kinematics}, and the uncertainties are statistical.}}{71}{table.caption.47}\protected@file@percent }
\newlabel{tab:z-profile}{{A.4}{71}{Mean value $\langle \cos 2\dpsi \rangle $ as a function of the momentum fraction $z_2$ of the second splitting, for the simulated jets labelled $g \to q\bar {q}$ and for those labelled $q \to qg$ or $g \to gg$, after the requirement of a matched score above $0.8$. The last column gives the difference between the two classes. The values correspond to the right panel of Figure~\ref {fig:z-kinematics}, and the uncertainties are statistical}{table.caption.47}{}}
\@writefile{lot}{\contentsline {table}{\numberline {A.5}{\ignorespaces Mean value $\langle \cos 2\psi \rangle $ of the three-point energy correlator for all jets in the collision data and in the simulated calibration sample, and for the simulated jets in each class of the channel label of the second splitting. All jets of the ntuples are included, also those without a valid $\Delta \psi _{12}$. The last two rows give the labelled classes used as references in Figure~\ref {fig:eeec-threshold}, after the requirement of a matched score above $0.8$ alone. The coefficient of the modulation is $a_2/a_0 = 2\langle \cos 2\psi \rangle $. The uncertainties are statistical and treat the jets as independent.}}{71}{table.caption.48}\protected@file@percent }
\newlabel{tab:eeec-classes}{{A.5}{71}{Mean value $\langle \cos 2\psi \rangle $ of the three-point energy correlator for all jets in the collision data and in the simulated calibration sample, and for the simulated jets in each class of the channel label of the second splitting. All jets of the ntuples are included, also those without a valid $\dpsi $. The last two rows give the labelled classes used as references in Figure~\ref {fig:eeec-threshold}, after the requirement of a matched score above $0.8$ alone. The coefficient of the modulation is $a_2/a_0 = 2\langle \cos 2\psi \rangle $. The uncertainties are statistical and treat the jets as independent}{table.caption.48}{}}
\@writefile{lot}{\contentsline {table}{\numberline {A.6}{\ignorespaces Mean value $\langle \cos 2\psi \rangle $ of the three-point energy correlator of the jets selected by the two-stage selection, as a function of the threshold on the $g \to q\bar  {q}$ score, in the collision data and in the simulated calibration sample. All jets have a matched score above $0.8$. The last two columns refer to the selected simulated jets labelled $g \to q\bar  {q}$. The uncertainties are statistical and treat the jets as independent.}}{72}{table.caption.49}\protected@file@percent }
\newlabel{tab:eeec-threshold}{{A.6}{72}{Mean value $\langle \cos 2\psi \rangle $ of the three-point energy correlator of the jets selected by the two-stage selection, as a function of the threshold on the $g \to q\bar {q}$ score, in the collision data and in the simulated calibration sample. All jets have a matched score above $0.8$. The last two columns refer to the selected simulated jets labelled $g \to q\bar {q}$. The uncertainties are statistical and treat the jets as independent}{table.caption.49}{}}
