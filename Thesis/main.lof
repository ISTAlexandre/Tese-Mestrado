\contentsline {figure}{\numberline {2.1}{\ignorespaces The average primary Lund plane density, ρ, for jets clustered with the C/A algorithm and $R= 1$ having $p_t > 2$ TeV and $|y|<2.5$, in a simulated QCD dijet sample \blx@tocontentsinit {0}\cite {Dreyer:2018nbf}.}}{13}{figure.caption.7}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Schematic representation of the different regions of the Lund plane \blx@tocontentsinit {0}\cite {Dreyer:2018nbf}.}}{14}{figure.caption.8}%
\contentsline {figure}{\numberline {2.3}{\ignorespaces Different representations for two jets. Top: the particles inside the jet. Middle: the full Lund diagram. Bottom: the primary Lund plane \blx@tocontentsinit {0}\cite {Dreyer:2018nbf}.}}{15}{figure.caption.9}%
\contentsline {figure}{\numberline {2.4}{\ignorespaces Azimuthal angles are defined between successive splitting planes for the $1 \to 23$ splitting, $\mathcal {P}_1 \supset \{\vec {p}_2, \vec {p}_3\}$, and the $2 \to 45$ splitting, $\mathcal {P}_2 \supset \{\vec {p}_4, \vec {p}_5\}$. The figure also depicts the vectors normal to the two planes, $\vec {n}_1$ and $\vec {n}_2$ \blx@tocontentsinit {0}\cite {Karlberg_2021}.}}{16}{figure.caption.10}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces A perspective view of the CMS detector \blx@tocontentsinit {0}\cite {CMS:2008}.}}{22}{figure.caption.11}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Schematic of the analysis pipeline. The extraction stage runs inside the CMS environment and produces the jet ntuples. The declustering, the generator-level labelling and the energy-correlator computation run outside it, and feed the flavour selection and the final measurement.}}{25}{figure.caption.16}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces Transverse-momentum distribution of the selected jets in the collision data and in the simulated samples with $600 < \hat {p}_{\mathrm {T}} < 800$~GeV and $800 < \hat {p}_{\mathrm {T}} < 1000$~GeV, normalised to unit area.}}{42}{figure.caption.23}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Number of constituents of the selected jets in the collision data and in the simulated samples with $600 < \hat {p}_{\mathrm {T}} < 800$~GeV and $800 < \hat {p}_{\mathrm {T}} < 1000$~GeV, normalised to unit area.}}{42}{figure.caption.24}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Average primary (top) and secondary (bottom) Lund jet planes of the jets with a valid $\Delta \psi _{12}$, in the collision data (left) and in the simulated sample with $600 < \hat {p}_{\mathrm {T}} < 800$~GeV (right). Only declusterings satisfying $z > 0.1$ are included. The colour scale shows the density of emissions per jet and per unit area, with the same scale for data and simulation in each row.}}{44}{figure.caption.25}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Distribution of $\Delta \psi _{12}$ for all jets with a valid value, before any flavour selection, in the collision data and in the simulated sample with $600 < \hat {p}_{\mathrm {T}} < 800$~GeV, normalised to unit area.}}{45}{figure.caption.26}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces Distribution of $\Delta \psi _{12}$ for all labelled jets and for the jets whose second splitting is labelled $g \to q\bar {q}$, in the simulated sample with $600 < \hat {p}_{\mathrm {T}} < 800$~GeV, normalised to unit area. The lower panel shows the ratio of the $g \to q\bar {q}$ distribution to that of all labelled jets.}}{47}{figure.caption.28}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces Distribution of the momentum fractions $z_1$ and $z_2$ of the first and second selected splittings, normalised to unit area, for all jets with a valid $\Delta \psi _{12}$ in the collision data and in the simulated calibration sample, and for the simulated jets labelled $g \to q\bar {q}$, $g \to gg$ and $q \to qg$ and those unmatched. Each panel gives the number of jets and the mean values of $z_1$ and $z_2$.}}{48}{figure.caption.29}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces Ratio of the normalised distributions of Figure~\ref {fig:zplane-channels} to that of all simulated jets, for the collision data and for the simulated jets labelled $g \to q\bar {q}$, $g \to gg$ and $q \to qg$. The colour scale is logarithmic and symmetric around unity, and ratios beyond its range are shown at its limits.}}{48}{figure.caption.30}%
\contentsline {figure}{\numberline {4.8}{\ignorespaces Performance of the first stage on the test subset of the simulated sample with $800 < \hat {p}_{\mathrm {T}} < 1000$~GeV. (a) ROC curve of the matched score. (b) Confusion matrix, in which each row is normalised to the number of splittings of the corresponding true class and each splitting is assigned to the class of highest probability.}}{50}{figure.caption.31}%
\contentsline {figure}{\numberline {4.9}{\ignorespaces Distribution of the $g \to q\bar {q}$ score of the second stage for the $g \to q\bar {q}$ class and for the $q \to qg$ and $g \to gg$ classes together, on the simulated calibration sample with $600 < \hat {p}_{\mathrm {T}} < 800$~GeV, normalised to unit area.}}{50}{figure.caption.32}%
\contentsline {figure}{\numberline {4.10}{\ignorespaces ROC curve (left) and precision-recall curve (right) of the $g \to q\bar {q}$ score of the second stage. The dashed line in the right panel shows the precision of a classifier without discriminating power.}}{51}{figure.caption.33}%
\contentsline {figure}{\numberline {4.11}{\ignorespaces Purity (left axis) and efficiency (right axis) of the second stage as a function of the threshold on the $g \to q\bar {q}$ score, for the splittings labelled $g \to q\bar {q}$, $q \to qg$ or $g \to gg$ in the simulated calibration sample. The dotted line shows the fraction of $g \to q\bar {q}$ splittings among these, before any selection.}}{52}{figure.caption.35}%
\contentsline {figure}{\numberline {4.12}{\ignorespaces Purity as a function of efficiency for the $g \to q\bar {q}$ channel, for the complete two-stage selection, for the first stage followed by the three-class network, and for the four-class network, applied to all labelled splittings of the simulated calibration sample. The vertical line marks the largest efficiency allowed by the requirement on the matched score, and the dotted line the purity before any selection.}}{53}{figure.caption.36}%
\contentsline {figure}{\numberline {4.13}{\ignorespaces Top: mean value $\langle \cos 2\Delta \psi _{12}\rangle $ of all jets selected by the two-stage selection in the simulated calibration sample, and of the selected jets labelled $g \to q\bar {q}$ and labelled $q \to qg$ or $g \to gg$, as a function of the threshold on the $g \to q\bar {q}$ score. All jets have a matched score above $0.8$. The horizontal lines show the mean values of the two classes with this requirement alone, without any threshold on the second score. Bottom: purity of the selected samples, with the jets without channel label counted as background and excluded, respectively.}}{54}{figure.caption.38}%
\contentsline {figure}{\numberline {4.14}{\ignorespaces Left: distribution of the momentum fraction $z_2$ of the second splitting for the jets labelled $g \to q\bar {q}$ and for those labelled $q \to qg$ or $g \to gg$ after the first stage, and for all jets selected at thresholds of $0.45$ and $0.60$, normalised to unit area. Right: mean value $\langle \cos 2\Delta \psi _{12}\rangle $ as a function of $z_2$ for the jets labelled $g \to q\bar {q}$ and for those labelled $q \to qg$ or $g \to gg$ after the first stage. All results are obtained on the simulated calibration sample.}}{56}{figure.caption.39}%
\contentsline {figure}{\numberline {4.15}{\ignorespaces Mean value $\langle \cos 2\Delta \psi _{12}\rangle $ of the jets selected by the two-stage selection as a function of the threshold on the $g \to q\bar {q}$ score, in the collision data and in the simulated calibration sample. All jets have a matched score above $0.8$. The horizontal lines show the mean values in simulation of the jets labelled $g \to q\bar {q}$ and of those labelled $q \to qg$ or $g \to gg$ after this requirement alone. The data points are shifted slightly to the right for readability, and the error bars show the statistical uncertainties.}}{57}{figure.caption.40}%
\contentsline {figure}{\numberline {4.16}{\ignorespaces Distribution of the azimuthal angle $\psi $ of the three-point energy correlator, normalised to unit area. The left panel compares all jets in the collision data and in the simulated calibration sample, with the ratio of data to simulation in the lower panel. The right panel shows the simulated jets labelled $g \to q\bar {q}$, $g \to gg$ and $q \to qg$ together with all simulated jets, with the ratio of each class to all jets in the lower panel. The dashed line in the left panel is the pure $\cos 2\psi $ modulation with the mean value of the simulation.}}{58}{figure.caption.41}%
\contentsline {figure}{\numberline {4.17}{\ignorespaces Mean value $\langle \cos 2\psi \rangle $ of the three-point energy correlator of the jets selected by the two-stage selection as a function of the threshold on the $g \to q\bar {q}$ score, in the collision data and in the simulated calibration sample. All jets have a matched score above $0.8$. The horizontal lines show the mean values in simulation of the jets labelled $g \to q\bar {q}$ and of those labelled $q \to qg$ or $g \to gg$ after this requirement alone. The data points are shifted slightly to the right for readability, and the error bars show the statistical uncertainties.}}{60}{figure.caption.42}%
